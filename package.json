{
  "name": "@local/understand-anything-dsh",
  "version": "1.1.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs tests/*.test.mjs",
    "test:dsh": "ELECTRON_RUN_AS_NODE=1 \"$DSH_NODE_EXECUTABLE\" --test test/skills-dsh.mjs test/host-dsh.mjs test/contract-v4.mjs"
  },
  "private": true,
  "description": "DSH adapter with nine full upstream skill aliases, next-step Git/stale notices, and a pinned reproducible DeepSeek blue theme. Upstream: github.com/Egonex-AI/Understand-Anything",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./host-v2": "./host-v2.js",
    "./host-v2/locale/*.json": "./locale/*.json",
    "./host-v2/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host-v2.js",
    "bridge.js",
    "runtime.js",
    "skills.js",
    "batch.js",
    "validation.js",
    "dashboard.js",
    "execution-gates.js",
    "phase.js",
    "scripts",
    "theme",
    "README.md",
    "install.sh",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
